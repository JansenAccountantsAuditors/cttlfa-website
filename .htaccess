# ==========================================================
# CTTLFA website (cttfa.co.za) — Apache / xneelo configuration
# Place this file in public_html together with index.html.
# ==========================================================

# ---- 1. Force HTTPS and force the www. host (matches the site's canonical) ----
RewriteEngine On

# ---- 1a. Referee & match submission forms (JotForm) — friendly cttfa.co.za links ----
RewriteRule ^junior-match-result/?$      https://form.jotform.com/221095830059556 [R=302,L,NC]
RewriteRule ^senior-match-result/?$      https://form.jotform.com/221082801095045 [R=302,L,NC]
RewriteRule ^referee-incident-report/?$  https://form.jotform.com/221095432461551 [R=302,L,NC]
RewriteRule ^team-return/?$              https://form.jotform.com/220944917396063 [R=302,L,NC]
RewriteRule ^referee-send-off/?$         https://form.jotform.com/221095015577051 [R=302,L,NC]
# /match and /match-result both open the Junior match result form
RewriteRule ^match/?$                    https://form.jotform.com/221095830059556 [R=302,L,NC]
RewriteRule ^match-result/?$             https://form.jotform.com/221095830059556 [R=302,L,NC]

# ---- 1b. Dashboard bridge: restore old cttfa.co.za paths lost when the previous
#          WordPress site was replaced. The operations dashboard lives on the
#          subdomain (dash.cttlfa.com) and is NOT touched by these rules. ----
RewriteRule ^announcements/?$                  https://dash.cttlfa.com/announcements [R=302,L,NC]
RewriteRule ^referee-appointments/?$           https://dash.cttlfa.com/referee-appointments [R=302,L,NC]
RewriteRule ^yellow-card-tracker/?$            https://dash.cttlfa.com/yellow-card-tracker [R=302,L,NC]
RewriteRule ^administrative-rulings-public/?$  https://dash.cttlfa.com/administrative-rulings-public [R=302,L,NC]
RewriteRule ^login/?$                          https://dash.cttlfa.com/login [R=302,L,NC]
# combined-logs stays on our own site (Junior Combined Logs page)
RewriteRule ^combined-logs/?$                  https://www.cttfa.co.za/combinedlogs [R=302,L,NC]

# add https if missing
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# add www if missing (non-www -> www)
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- 1b3. Per-page share previews for link crawlers only (WhatsApp, Facebook, etc.).
#           Humans and search engines get the real app; only known preview-bot UAs get a static OG stub. ----
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|vkShare) [NC]
RewriteRule ^$ /og/home.html [L]
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|vkShare) [NC]
RewriteCond %{DOCUMENT_ROOT}/og/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ /og/$1.html [L]

# ---- 1c. Prerendered per-route pages (SEO): each clean URL is served its own
#          static HTML from /p, identical to the app but with a page-specific
#          title, description and self-canonical, so search engines index each
#          page in its own right. Generated at build time by prerender.js. Any
#          route without a prerendered file falls through to the app shell below. ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/p/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ /p/$1.html [L]

# ---- 1d. Single-page-app fallback: clean URLs (no #) are served the app shell.
#          Real files and folders are served normally; the redirects above run first. ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# ---- 2. Compress text, HTML, CSS, JS and JSON (gzip) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
    text/javascript application/javascript application/x-javascript \
    application/json application/xml image/svg+xml
</IfModule>

# ---- 3. Browser caching. Static media cached hard; the page and the live
#         league feed kept short so updates come through quickly. ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/json "access plus 5 minutes"
</IfModule>

# ---- 4. Basic security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # keep the live feed and the page fresh
  <FilesMatch "season\.json$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- 5. Default document ----
DirectoryIndex index.html
